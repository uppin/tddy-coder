#!/usr/bin/env bash
# Build optimized production binaries. Uses nix dev shell for consistent toolchain.
# Output: target/release/tddy-coder, target/release/tddy-tools, target/release/tddy-daemon,
#         target/release/tddy-supervisor, target/release/tddy-remote-git-repo,
#         target/release/tddy-session-sync, target/release/tddy-sandbox-runner,
#         target/release/tddy-index-daemon
#
# Usage: ./release [--desktop]
#
#   --desktop   Additionally build everything `./install --desktop` ships: the tddy-web bundle and
#               then the Tauri application. Output: packages/tddy-web/dist and, on macOS,
#               target/release/bundle/macos/Tddy Desktop.app; on Linux target/release/tddy-desktop.
#
# tddy-sandbox-runner is the process every jail runs inside itself (sandboxed claude-cli and
# cursor-cli sessions, and the workspace tool jail). tddy-index-daemon is the process that holds a
# warm rust-analyzer index per workspace root. ./install and publish.sh both ship what this script
# builds, so a package missing from this line is a binary missing from every installed host — and
# ./install pre-flights every name in its INSTALLED_BINARIES array, so a name there and not here
# fails the install rather than the build.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

DESKTOP_APP_NAME="Tddy Desktop"

usage() {
  echo "Usage: $0 [--desktop]" >&2
}

want_desktop=false
for arg in "$@"; do
  case "$arg" in
    --desktop) want_desktop=true ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "release: unknown argument: $arg" >&2
      usage
      exit 1
      ;;
  esac
done

in_shell() {
  nix develop --profile ./.nix-profile -c "$@"
}

in_shell cargo build --release \
  -p tddy-coder \
  -p tddy-tools \
  -p tddy-sandbox-darwin \
  -p tddy-sandbox-app \
  -p tddy-sandbox-runner \
  -p tddy-daemon \
  -p tddy-supervisor \
  -p tddy-remote-git-repo \
  -p tddy-session-sync \
  -p tddy-index-daemon

if [[ "$want_desktop" != true ]]; then
  exit 0
fi

# Order matters and is not interchangeable: `frontendDist` in tauri.conf.json points at
# packages/tddy-web/dist, and `tauri build` READS that directory rather than building it. Building
# the application before the bundle bakes a stale dashboard into it, silently.
echo "release: --desktop — building the tddy-web bundle (the application embeds it)"
in_shell bun run build

# Build ONLY the artifact `./install --desktop` consumes. tauri.conf.json lists four bundle targets
# because it also describes distribution; a local install uses exactly one of them per platform, and
# the others are pure cost or an outright failure:
#
#   macOS  --bundles app  the .app, which is what gets copied into ~/Applications. The `dmg` target
#                         drives Finder over AppleScript via bundle_dmg.sh and fails without
#                         Automation permission, AFTER the .app is already complete and valid.
#   Linux  --no-bundle    target/release/tddy-desktop, the plain binary the install puts on PATH.
#                         The .desktop entry and the icon come from the source tree
#                         (packages/tddy-desktop/src-tauri/icons/), never from a deb or AppImage.
if [[ "$(uname -s)" == "Darwin" ]]; then
  desktop_bundle_args=(--bundles app)
  desktop_artifact="${ROOT_DIR}/target/release/bundle/macos/${DESKTOP_APP_NAME}.app"
else
  desktop_bundle_args=(--no-bundle)
  desktop_artifact="${ROOT_DIR}/target/release/tddy-desktop"
fi

echo "release: --desktop — building the application (tauri build ${desktop_bundle_args[*]})"
status=0
in_shell bun run desktop:build "${desktop_bundle_args[@]}" || status=$?
if [[ "$status" -eq 0 ]]; then
  exit 0
fi

# Do not swallow this. A tauri build can fail at a step that runs after the artifact is already
# written, so say which of the two happened instead of reporting a uniform failure the operator
# cannot act on. The exit status is still the build's.
echo "release: tauri build failed (exit ${status})" >&2
if [[ -e "$desktop_artifact" ]]; then
  echo "release: the artifact ./install --desktop needs IS present:" >&2
  echo "release:   ${desktop_artifact}" >&2
  echo "release: a later step failed, not the application. ./install --desktop (without --build)" >&2
  echo "release:   installs what is already built." >&2
fi
exit "$status"

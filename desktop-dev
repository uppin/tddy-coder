#!/usr/bin/env bash
# Start Tddy Desktop in development: the Tauri app hosting tddy-daemon in its own process, with the
# tddy-web Vite dev server for HMR.
#
# The counterpart of ./web-dev, and deliberately repo-local: an installed app keeps its
# configuration and data under ~/.tddy, while this uses the checkout's dev.desktop.yaml and
# tmp/.tddy so a dev run never touches an installed app's state.
#
# Usage: ./desktop-dev                   # dev.desktop.yaml at the repo root
#        ./desktop-dev --release         # extra CLI for `tauri dev` (pass-through)
#
# Every binary the app can INVOKE is built by default, before anything starts. `tauri dev` builds
# only tddy-desktop; the daemon it hosts then resolves the session worker, the tool binary, the
# sandbox runner, the index daemon, the git shim and the worktree mirror as siblings of that binary
# in target/debug, and falls back to a bare name on PATH with no existence check. Leaving that to a
# flag meant the common case was a stack missing a sibling — surfacing much later as a session that
# will not start, or as a dev run silently driving whatever ./install last put on PATH. The build is
# incremental and costs nothing when the binaries are current, so it is no longer opt-in.
# See scripts/dev-runtime-binaries.sh.
#
#        ./desktop-dev --build           # the default; accepted so an existing habit or script
#                                          keeps working, and to say the build is wanted explicitly.
#        ./desktop-dev --no-build        # skip it. For a run that must not touch target/debug —
#                                          e.g. driving binaries another checkout or ./install
#                                          placed there on purpose.
#        ./desktop-dev --resolve-private-repo
#                                        # install the JS dependencies through the local private npm
#                                          registry (LOCAL_REGISTRY_URL) instead of the public one,
#                                          via `bun run local-registry-install`. Needed on a machine
#                                          with no public registry access; it rewrites node_modules,
#                                          so it is opt-in rather than automatic.
#
# All of these flags are consumed here; every other argument is passed through to `tauri dev`,
# which accepts none of them.
#
# Environment variables:
#   VITE_PORT       — Port for the Vite dev server (default: 5173)
#   VITE_URL        — Origin the app loads its UI from (default: http://localhost:<VITE_PORT>).
#                     `tauri dev` is told to wait on this, so a non-default port works.
#   TDDY_DAEMON_CONFIG — YAML for the embedded tddy-daemon (default: dev.desktop.yaml at repo root).
#   TDDY_DATA_DIR   — Where sessions and daemon state live (default: tmp/.tddy in the checkout).
#                     An installed app defaults to ~/.tddy; this keeps a dev run out of it.
#   TDDY_WORKSPACE_ROOT — The checkout the app resolves config and relative paths against.
#   LOCAL_REGISTRY_URL — Private npm registry used by --resolve-private-repo (default: the one
#                     scripts/local-bun-install.sh declares).
#
# Repo-root .env is loaded first and never overrides an already-set variable, the same rule
# ./web-dev follows.
set -euo pipefail
set -m

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# This script lives AT the repo root, so the root is its own directory — the same place
# ./web-dev resolves with `cd "$(dirname "$0")"`. Going up a level pointed TDDY_WORKSPACE_ROOT,
# TDDY_DATA_DIR and the dev.desktop.yaml lookup at the checkout's parent, where none of them exist.
PROJECT_ROOT="$SCRIPT_DIR"

VITE_PORT="${VITE_PORT:-5173}"
export VITE_URL="${VITE_URL:-http://localhost:${VITE_PORT}}"

cd "$PROJECT_ROOT"

# The toolchain — bun, cargo, tauri — comes from the nix dev shell, and every other root script
# wraps itself in it (./test and ./verify via `nix develop -c bash -c`, ./release via exec). This one
# did not, so a plain `./desktop-dev` from an ordinary shell died on `bun: command not found` at the
# first Vite line, which is not what its own usage block promises. Re-exec through the same GC-rooted
# profile the siblings use, unless the toolchain is already on PATH — so running it from inside
# `./dev` costs nothing, and a `nix`-less machine still gets bun's own error rather than nix's.
#
# The sentinel makes the re-exec once-only: if the shell comes up still missing bun, fail with that
# error instead of spawning nix forever.
if [[ -z "${TDDY_DESKTOP_DEV_RESHELLED:-}" ]] \
  && { ! command -v bun >/dev/null 2>&1 || ! command -v cargo >/dev/null 2>&1; }; then
  export TDDY_DESKTOP_DEV_RESHELLED=1
  exec nix develop --profile ./.nix-profile -c "$SCRIPT_DIR/desktop-dev" "$@"
fi

# Flags this script owns, parsed after the re-exec above so that exec still forwards the original
# argv. Consumed here; everything else is passed through to `tauri dev`.
# Default: build the runtime-invocable siblings. See the usage header for why this is not opt-in.
WANT_BUILD=true
RESOLVE_PRIVATE_REPO=false
filtered_args=()
for arg in "$@"; do
  case "$arg" in
    --build) WANT_BUILD=true ;;
    --no-build) WANT_BUILD=false ;;
    --resolve-private-repo) RESOLVE_PRIVATE_REPO=true ;;
    *) filtered_args+=("$arg") ;;
  esac
done
set -- "${filtered_args[@]+"${filtered_args[@]}"}"

# DEV_RUNTIME_PACKAGES + dev_runtime_cargo_args() — the one list of runtime-invocable packages,
# shared with ./web-dev so the two launchers cannot drift apart.
# shellcheck source=scripts/dev-runtime-binaries.sh
source "$PROJECT_ROOT/scripts/dev-runtime-binaries.sh"

# Load .env if present (does not override already-set env vars) — same as ./web-dev.
if [[ -f .env ]]; then
  while IFS='=' read -r key value; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    if [[ -z "${!key+x}" ]]; then
      export "$key=$value"
    fi
  done < .env
fi

# The app resolves the repo root from cwd / TDDY_WORKSPACE_ROOT. `cargo tauri dev` runs from
# packages/tddy-desktop/src-tauri, so name it here rather than relying on the upward walk.
export TDDY_WORKSPACE_ROOT="${TDDY_WORKSPACE_ROOT:-$PROJECT_ROOT}"

# Sessions and daemon state stay inside the checkout, so a dev run never writes into the ~/.tddy an
# installed app owns. Exported rather than left to the YAML so it holds for any config passed in.
export TDDY_DATA_DIR="${TDDY_DATA_DIR:-$PROJECT_ROOT/tmp/.tddy}"
mkdir -p "$TDDY_DATA_DIR"

# Daemon config for the in-process tddy-daemon (dev.desktop.yaml at the repo root).
if [[ -z "${TDDY_DAEMON_CONFIG:-}" ]] && [[ -f "$PROJECT_ROOT/dev.desktop.yaml" ]]; then
  export TDDY_DAEMON_CONFIG="$PROJECT_ROOT/dev.desktop.yaml"
fi

VITE_PID=""
CLEANED_UP=0

# Stop the background Vite job (bun + node/vite). Idempotent for INT/EXIT both firing.
stop_vite() {
  [[ "$CLEANED_UP" -eq 1 ]] && return 0
  CLEANED_UP=1
  if [[ -z "${VITE_PID:-}" ]]; then
    return 0
  fi
  if ! kill -0 "$VITE_PID" 2>/dev/null; then
    return 0
  fi
  # Negative PID: signal the whole process group (leader PID == PGID from `set -m` + `&`).
  kill -TERM -"$VITE_PID" 2>/dev/null || kill -TERM "$VITE_PID" 2>/dev/null || true
  local i
  for ((i = 0; i < 40; i++)); do
    kill -0 "$VITE_PID" 2>/dev/null || break
    sleep 0.05
  done
  if kill -0 "$VITE_PID" 2>/dev/null; then
    kill -KILL -"$VITE_PID" 2>/dev/null || kill -KILL "$VITE_PID" 2>/dev/null || true
  fi
  wait "$VITE_PID" 2>/dev/null || true
}

trap stop_vite EXIT
trap 'stop_vite; exit 130' INT
trap 'stop_vite; exit 143' TERM

# --resolve-private-repo / --build: both run before anything is started, so a failure leaves no
# half-started stack behind — and so the Vite readiness wait below is not charged for a cold build.
if [[ "$RESOLVE_PRIVATE_REPO" == true ]]; then
  echo "Installing JS dependencies from the private registry (${LOCAL_REGISTRY_URL:-default}) ..."
  bun run local-registry-install
fi

if [[ "$WANT_BUILD" == true ]]; then
  # tddy-desktop itself is left to `tauri dev`, which owns its build; these are the siblings it
  # resolves at runtime and never builds.
  dev_runtime_cargo_args
  echo "Building (debug): ${DEV_RUNTIME_CARGO_PACKAGES[*]} ..."
  cargo build "${DEV_RUNTIME_CARGO_ARGS[@]}"
fi

echo "Starting tddy-web Vite dev server on port ${VITE_PORT} ..."
bun run --filter tddy-web dev &
VITE_PID=$!

echo "Waiting for ${VITE_URL} ..."
ready=0
for _ in $(seq 1 120); do
  if curl -s -o /dev/null -f --max-time 2 "${VITE_URL}/"; then
    ready=1
    break
  fi
  sleep 0.5
done

if [[ "$ready" -ne 1 ]]; then
  echo "Error: Vite did not become ready at ${VITE_URL}" >&2
  exit 1
fi

# `devUrl` in tauri.conf.json is the 5173 default; override it here so `tauri dev` waits on the
# server this script actually started when VITE_PORT / VITE_URL point somewhere else.
echo "Starting Tddy Desktop (VITE_URL=${VITE_URL}) ..."
bun run --filter tddy-desktop dev --config "{\"build\":{\"devUrl\":\"${VITE_URL}\"}}" "$@"

#!/usr/bin/env bash
# Build tddy-coder + tddy-tools, then run tests. Uses nix dev shell.
# Output also written to .verify-result.txt (agent workaround for Cursor terminal capture bug).
# Usage: ./test                    — run all tests
#        ./test -p tddy-core       — run tests for one package
#        ./test -- test_name       — run a specific test
set -e
cd "$(dirname "$0")"

nix develop --profile ./.nix-profile -c bash -c '
  set -e
  set -o pipefail
  # --bins: required alongside --examples so tddy-acp-stub (bin-only, no examples) is built.
  # tddy-sandbox-runner is here because the jail acceptance suites spawn it as a *binary* from
  # target/debug rather than linking it. Those tests run in packages that do not own it, so cargo
  # sets no CARGO_BIN_EXE_ for them and never rebuilds it on their behalf — without this line a
  # change to the runner is tested against whatever build happened to be on disk, and the suite
  # goes green against the old jail. The fixtures check the binary exists; nothing checks its age.
  cargo build -p tddy-coder -p tddy-tools -p tddy-sandbox-darwin -p tddy-sandbox-runner -p tddy-build -p tddy-livekit -p tddy-livekit-screen-capture -p tddy-acp-stub -p tddy-demo-tui --examples --bins
  cargo test "$@" -- --test-threads=1 2>&1 | tee .verify-result.txt
' -- "$@"

{
  "name": "tddy-hosts-web",
  "version": "0.1.0",
  "description": "Hosts and VMs: the hosts screen and rows, host key continuity, desktop/passphrase dialogs, host stats indicators, screen-sharing and VNC overlays",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src && bun run cypress:component",
    "test:ci": "bun test src --reporter=junit --reporter-outfile=../../reports/junit/hosts-web.xml",
    "cypress:component": "CYPRESS_DISABLE_REACT_COMPILER=1 ELECTRON_EXTRA_LAUNCH_ARGS='--disable-gpu --no-sandbox' cypress run --component",
    "cypress:component:ci": "bun run cypress:component -- --reporter junit --reporter-options 'mochaFile=../../reports/junit/hosts-web-component-[hash].xml'"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@connectrpc/connect": "^2.0.0",
    "tddy-client-web": "workspace:*",
    "tddy-react-commons": "workspace:*",
    "tddy-ui-web": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tddy-connectrpc-testkit": "workspace:*",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}

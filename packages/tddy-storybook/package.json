{
  "name": "tddy-storybook",
  "version": "0.1.0",
  "description": "The one Storybook for the tddy web component packages; owns every story",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "prebuild": "bun run --cwd ../tddy-livekit-rpc-web build",
    "build": "storybook build",
    "build-storybook": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:ci": "bun test src --reporter=junit --reporter-outfile=../../reports/junit/storybook.xml"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tddy-chat-web": "workspace:*",
    "tddy-client-web": "workspace:*",
    "tddy-connectrpc-testkit": "workspace:*",
    "tddy-hosts-web": "workspace:*",
    "tddy-livekit-web": "workspace:*",
    "tddy-prstack-web": "workspace:*",
    "tddy-react-commons": "workspace:*",
    "tddy-rpc-playground-web": "workspace:*",
    "tddy-session-create-web": "workspace:*",
    "tddy-session-web": "workspace:*",
    "tddy-terminal-web": "workspace:*",
    "tddy-ui-web": "workspace:*",
    "tddy-workspace-web": "workspace:*"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/react": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "storybook": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}

{
  "name": "tddy-livekit-web",
  "version": "0.1.0",
  "description": "LiveKit for the tddy web app: the common room, presence, the LiveKit connection provider and the room-RPC port, registered through one call",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testkit": "./src/testkit/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run cypress:component",
    "test:unit": "bun test src",
    "test:ci": "bun test src --reporter=junit --reporter-outfile=../../reports/junit/livekit-web.xml",
    "cypress:component": "CYPRESS_DISABLE_REACT_COMPILER=1 ELECTRON_EXTRA_LAUNCH_ARGS='--disable-gpu --no-sandbox' cypress run --component",
    "cypress:component:ci": "bun run cypress:component -- --reporter junit --reporter-options 'mochaFile=../../reports/junit/livekit-web-component-[hash].xml'"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@connectrpc/connect": "^2.0.0",
    "debug": "^4.4.3",
    "livekit-client": "^2.17.0",
    "lucide-react": "^1.7.0",
    "tddy-client-web": "workspace:*",
    "tddy-livekit-rpc-web": "workspace:*",
    "tddy-react-commons": "workspace:*",
    "tddy-ui-web": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^14.0.0",
    "livekit-server-sdk": "^2.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tddy-connectrpc-testkit": "workspace:*",
    "tddy-rpc-web": "workspace:*",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}

        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'<STUBS>/tddy-tools' session-hook --session <SESSION_ID> --daemon http://127.0.0.1:8899 --os-user <OS_USER> --hook-token <HOOK_TOKEN> --event SessionStart",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'<STUBS>/tddy-tools' session-hook --session <SESSION_ID> --daemon http://127.0.0.1:8899 --os-user <OS_USER> --hook-token <HOOK_TOKEN> --event Stop",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "'<STUBS>/tddy-tools' session-hook --session <SESSION_ID> --daemon http://127.0.0.1:8899 --os-user <OS_USER> --hook-token <HOOK_TOKEN> --event UserPromptSubmit",
            "type": "command"
          }

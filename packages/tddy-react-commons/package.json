{
  "name": "tddy-react-commons",
  "version": "0.1.0",
  "description": "Composable React framework: typed component events, rxjs-backed stores, an app container, typed ports, async helpers and a testkit",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events/index.tsx",
    "./stores": "./src/stores/index.ts",
    "./container": "./src/container/index.tsx",
    "./ports": "./src/ports/index.ts",
    "./async": "./src/async/index.ts",
    "./testkit": "./src/testkit/index.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:ci": "bun test src --reporter=junit --reporter-outfile=../../reports/junit/react-commons.xml"
  },
  "dependencies": {
    "dequal": "^2.0.3",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}

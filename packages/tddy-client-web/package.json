{
  "name": "tddy-client-web",
  "version": "0.1.0",
  "description": "What a tddy web component package may know about the outside world: generated RPC code and the clients, navigation and auth ports",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./gen/*": "./src/gen/*.ts",
    "./connections/*": "./src/connections/*.ts",
    "./testkit": "./src/testkit/index.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "../../scripts/generated-code.sh write packages/tddy-client-web",
    "typecheck": "tsc --noEmit",
    "test": "bun test src && bun run cypress:component",
    "test:ci": "bun test src --reporter=junit --reporter-outfile=../../reports/junit/client-web.xml",
    "cypress:component": "CYPRESS_DISABLE_REACT_COMPILER=1 ELECTRON_EXTRA_LAUNCH_ARGS='--disable-gpu --no-sandbox' cypress run --component",
    "cypress:component:ci": "bun run cypress:component -- --reporter junit --reporter-options 'mochaFile=../../reports/junit/client-web-component-[hash].xml'"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-web": "^2.0.0",
    "tddy-react-commons": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.50.0",
    "@bufbuild/protoc-gen-es": "^2.2.0",
    "@happy-dom/global-registrator": "^20.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tddy-connectrpc-testkit": "workspace:*",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}

#!/usr/bin/env bash
# Start or reuse a warm code-intelligence daemon for this checkout, and print how to reach it.
#
# tddy-index-daemon holds a warm rust-analyzer index per workspace root, so `tddy-tools restructure`
# stops paying a six-to-ten-minute crate-graph load on every invocation. The handshake is the one
# run-livekit-testkit-server established: narration on stderr, one machine-readable line on stdout.
#
# Usage:
#   ./run-index-daemon              # start or reuse, then print the export line
#   ./run-index-daemon --status     # report what is running; start nothing
#   ./run-index-daemon --stop       # stop this checkout's daemon
#
# Output (stdout, one line, nothing else):
#   export TDDY_INDEX_SOCKET=/path/to/tddy-index-<tag>.sock
#
# To use it:
#   eval $(./run-index-daemon | grep '^export ')
#   cargo run -p tddy-tools -- restructure check plan.jsonl
#
# Everything else — what it did, where the log is, how to stop it — goes to stderr, so the eval
# above sees exactly one assignment.
#
# Environment variables:
#   TDDY_INDEX_RUNTIME_DIR  — where the socket, pid file and log live (default: $TMPDIR, else /tmp;
#                             a `nix develop` TMPDIR is not used, see durable_tmpdir).
#                             Deliberately not inside the checkout: an AF_UNIX path is limited to
#                             ~104 bytes and a worktree path plus a subdirectory already exceeds it.
#   TDDY_INDEX_LOG          — RUST_LOG for the daemon (default: info). Readiness is read from the
#                             daemon's own `listening on …` line, which it logs at info — a level
#                             below that starts a daemon this script cannot confirm.
set -euo pipefail
cd "$(dirname "$0")"

ROOT_DIR="$(pwd -P)"

# A temporary directory that outlives the shell this script was started from.
#
# Inside `./dev` (or any `nix develop`) TMPDIR is `/tmp/nix-shell.XXXX`, which nix deletes when that
# shell exits — and the daemon is built to outlive it. A socket, pid file or log there vanishes under
# a running daemon, and so does the TMPDIR its rust-analyzer copies `Cargo.lock` into for every
# build-script run. The user's own temporary directory is what such a shell replaced: on macOS
# that is `getconf DARWIN_USER_TEMP_DIR` (the per-user `/var/folders/…/T/`), and where `getconf`
# does not know that name — every other platform — it is `/tmp`, the same default this script had
# before.
durable_tmpdir() {
  case "${TMPDIR:-}" in
    "" | */nix-shell.*) getconf DARWIN_USER_TEMP_DIR 2>/dev/null || printf '/tmp' ;;
    *) printf '%s' "$TMPDIR" ;;
  esac
}
DURABLE_TMPDIR="$(durable_tmpdir)"
DURABLE_TMPDIR="${DURABLE_TMPDIR%/}"

RUNTIME_DIR="${TDDY_INDEX_RUNTIME_DIR:-$DURABLE_TMPDIR}"
RUNTIME_DIR="${RUNTIME_DIR%/}"

# One daemon per checkout, keyed by its path. Not one for the machine: the daemon serves whichever
# roots its clients name, but it *is* the binary built from this tree — reusing another worktree's
# daemon would silently run that worktree's restructuring code against this one's source.
TAG="$(printf '%s' "$ROOT_DIR" | cksum | awk '{print $1}')"
SOCKET="${RUNTIME_DIR}/tddy-index-${TAG}.sock"
PID_FILE="${RUNTIME_DIR}/tddy-index-${TAG}.pid"
LOG_FILE="${RUNTIME_DIR}/tddy-index-${TAG}.log"
BINARY="${ROOT_DIR}/target/debug/tddy-index-daemon"

# Long enough for a debug-profile binary to come up on a loaded machine; short enough that a daemon
# which never binds is reported rather than waited on forever.
READY_TICKS=150
READY_TICK_SECONDS=0.2

narrate() { echo "$@" >&2; }

# The pid of the daemon this checkout started, if it is still running.
running_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s' "$pid"
}

# The one line stdout carries, plus the narration a developer needs around it.
announce() {
  local pid="$1"
  narrate ""
  narrate "index daemon pid ${pid}, serving code_index.CodeIndexService on ${SOCKET}"
  narrate "log:  ${LOG_FILE}"
  narrate "stop: ./run-index-daemon --stop   (or: kill ${pid})"
  narrate ""
  narrate "To run against it:"
  narrate "  eval \$(./run-index-daemon | grep '^export ')"
  narrate "  cargo run -p tddy-tools -- restructure check plan.jsonl"
  narrate ""
  echo "export TDDY_INDEX_SOCKET=${SOCKET}"
}

stop_daemon() {
  local pid
  if ! pid="$(running_pid)"; then
    narrate "No index daemon is running for ${ROOT_DIR}"
    rm -f "$PID_FILE"
    exit 0
  fi
  narrate "Stopping index daemon pid ${pid}"
  # SIGTERM, not SIGKILL: the daemon's own shutdown path is what takes its rust-analyzer children
  # with it, and killing it outright orphans a multi-gigabyte server per warm root.
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 "$READY_TICKS"); do
    kill -0 "$pid" 2>/dev/null || break
    sleep "$READY_TICK_SECONDS"
  done
  if kill -0 "$pid" 2>/dev/null; then
    narrate "It did not stop on SIGTERM; killing it"
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  exit 0
}

case "${1:-}" in
  --stop)
    stop_daemon
    ;;
  --status)
    # A pid and a socket file are both inferences: a pid proves something with that number is
    # alive, and a socket file outlives the process that bound it. Only an answer proves a daemon
    # is reachable, so this dials and asks — which is what `tddy-index-daemon --ping` is for.
    #
    # The binary has to exist to ask. Not built here: `--status` starts nothing, and building is
    # how the start path begins, so a status that compiled a daemon would surprise its caller.
    if [[ ! -x "$BINARY" ]]; then
      narrate "No index daemon binary at ${BINARY} — nothing has been started from this checkout."
      exit 1
    fi
    # The ping's own answer goes to stderr with the rest of the narration: this script's stdout is
    # one line, the `export`, and `eval $(./run-index-daemon --status)` has to stay safe.
    if "$BINARY" --ping "$SOCKET" >&2; then
      if pid="$(running_pid)"; then
        narrate "Index daemon pid ${pid} is serving ${SOCKET}"
      fi
      echo "export TDDY_INDEX_SOCKET=${SOCKET}"
      exit 0
    fi
    # The pid file disagreeing with the socket is worth saying out loud rather than flattening to
    # "nothing is running": it means a daemon died without cleaning up, and the next start has to
    # clear the socket it left.
    if pid="$(running_pid)"; then
      narrate "Index daemon pid ${pid} is alive but is not answering on ${SOCKET}."
      narrate "Stop it and start again: ./run-index-daemon --stop && ./run-index-daemon"
    else
      narrate "No index daemon is running for ${ROOT_DIR}"
    fi
    exit 1
    ;;
  "")
    ;;
  *)
    narrate "run-index-daemon: unknown argument '$1'. Use --status, --stop, or no argument."
    exit 2
    ;;
esac

# Reuse before starting, the rule run-livekit-testkit-server states: a second daemon on a second
# socket would load the crate graph again, which is the cost this whole thing exists to pay once.
if pid="$(running_pid)"; then
  if [[ -S "$SOCKET" ]]; then
    narrate "Reusing index daemon pid ${pid}"
    announce "$pid"
    exit 0
  fi
  narrate "Index daemon pid ${pid} is running but ${SOCKET} is gone; restarting it"
  kill "$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
fi

mkdir -p "$RUNTIME_DIR"

# The daemon refuses to bind a path that already exists, because a socket file is indistinguishable
# from one a live daemon is serving on and taking it away would leave that daemon unreachable. Here
# the pid file is the evidence that no such daemon exists — running_pid failed above — so clearing
# it is the operator's own answer rather than a guess.
if [[ -e "$SOCKET" ]]; then
  narrate "Clearing ${SOCKET}, left behind by a daemon that is no longer running"
  rm -f "$SOCKET"
fi

narrate "Building tddy-index-daemon"
nix develop --profile ./.nix-profile -c cargo build -p tddy-index-daemon >&2

if [[ ! -x "$BINARY" ]]; then
  narrate "run-index-daemon: ${BINARY} was not built"
  exit 1
fi

# The daemon spawns rust-analyzer, and rust-analyzer runs every build script and proc macro in the
# workspace to load `OUT_DIR` code — so it needs the dev shell's whole environment, not only its PATH.
# Launching the binary directly with that environment, rather than through `nix develop -c`, keeps
# `$!` the daemon's own pid: wrapping it would record the wrapper's, and `--stop` would then kill the
# wrapper and orphan the daemon it was supposed to stop.
#
# PATH alone was not enough, and failed silently: the linker the nix toolchain drives needs the
# shell's `NIX_*` flags and SDK, so under a PATH-only environment the build scripts of `webrtc-sys`
# and the `sqlx-macros` proc macro fail to link inside rust-analyzer — while the same command
# succeeds in the dev shell. rust-analyzer then reports its index as degraded and answers without
# the code it could not build; that is where `req: _` signatures came from. The daemon gets exactly
# what `./dev` gets, the caller's environment included: `nix develop` is impure and passes the
# caller's variables through, so a host `LDFLAGS`/`CPPFLAGS` (Homebrew sets both) reaches the daemon
# just as it reaches a `./dev cargo build`. That is intended — the daemon's rust-analyzer then
# builds with the same linker configuration as the developer's own cargo does in the dev shell.
#
# Without rust-analyzer on PATH at all the daemon comes up, binds, serves, and refuses every
# LSP-backed operation with `Unavailable: lsp server exited`.
narrate "Resolving the dev shell's environment so the daemon's rust-analyzer builds what cargo builds"
DEV_SHELL_ENV=()
while IFS= read -r -d '' assignment; do
  DEV_SHELL_ENV+=("$assignment")
done < <(nix develop --profile ./.nix-profile -c env -0)
DEV_SHELL_PATH=""
for assignment in "${DEV_SHELL_ENV[@]}"; do
  if [[ "$assignment" == PATH=* ]]; then
    DEV_SHELL_PATH="${assignment#PATH=}"
  fi
done
if [[ -z "$DEV_SHELL_PATH" ]]; then
  narrate "run-index-daemon: could not read the dev shell's environment; the daemon would not find rust-analyzer"
  exit 1
fi

# `setsid` comes from the dev shell, so a host without util-linux on its own PATH is not a reason
# for the daemon to come up un-detached. Resolved explicitly rather than trusted to a `VAR=x cmd`
# prefix, because the shell looks a command up on the PATH it already has, not the one the prefix
# sets. Resolved in a subshell that assigns PATH, not through `env PATH=… command -v`: `command` is
# a shell builtin, and `env` runs it as a program on disk — which only macOS ships.
SETSID="$(PATH="$DEV_SHELL_PATH"; command -v setsid || true)"
if [[ -z "$SETSID" ]]; then
  narrate "run-index-daemon: the dev shell provides no setsid, so the daemon could not be given a"
  narrate "session of its own — and one that shares this shell's process group does not outlive it."
  exit 1
fi

narrate "Starting index daemon on ${SOCKET}, in a session of its own"
# `setsid`, not `nohup`. `nohup` blocks SIGHUP and nothing else: a background job stays in the
# process group of the shell that started it, so a caller that tears that group down when its
# command finishes — an agent harness, a CI step, a terminal closing on a job-control shell — takes
# the daemon with it. That is what made several starts announce `listening on …` and then refuse the
# connection seconds later, with the socket file still on disk. A session of its own is what makes
# this a daemon rather than a background job.
#
# The pid is written from inside the process that becomes the daemon, not taken from `$!`: `setsid`
# forks when its caller is already a process group leader and execs in place when it is not, so `$!`
# is the daemon's pid in some shells and a wrapper's in others — and `--stop` reading the wrong one
# kills the wrapper and orphans the multi-gigabyte server. `exec` leaves `$$` the daemon's own pid
# either way.
#
# stderr to the log by shell redirection rather than via the daemon's own --log-file, so this script
# owns the truncation: readiness is decided by finding `listening on` in the file, and an appended
# log would answer with the previous run's line. The truncation happens here, before the launch, and
# not in the background job's own `2>` — that runs whenever the job gets scheduled, and a readiness
# loop that ticks first reads the previous daemon's `listening on` and announces a daemon that has
# not started, with no pid file behind it.
rm -f "$PID_FILE"
: >"$LOG_FILE"
# The temporary directories are the one part of the dev shell's environment not taken: `nix develop`
# points all four (and `NIX_BUILD_TOP`) at a directory of its own and deletes it when it exits, and
# rust-analyzer copies `Cargo.lock` into `TMPDIR` for every build-script run.
env -i "${DEV_SHELL_ENV[@]}" \
  TMPDIR="$DURABLE_TMPDIR" TMP="$DURABLE_TMPDIR" TEMP="$DURABLE_TMPDIR" TEMPDIR="$DURABLE_TMPDIR" \
  NIX_BUILD_TOP="$DURABLE_TMPDIR" \
  RUST_LOG="${TDDY_INDEX_LOG:-info}" \
  "$SETSID" sh -c 'echo $$ >"$1"; exec "$2" --grpc-uds "$3"' \
  run-index-daemon "$PID_FILE" "$BINARY" "$SOCKET" \
  </dev/null >/dev/null 2>>"$LOG_FILE" &

daemon_pid=""
for _ in $(seq 1 "$READY_TICKS"); do
  # The pid file appears a moment after the fork, so it is read each tick until it is there rather
  # than once before the loop.
  if [[ -z "$daemon_pid" && -s "$PID_FILE" ]]; then
    daemon_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  fi

  if grep -q "listening on ${SOCKET}" "$LOG_FILE" 2>/dev/null; then
    if [[ -z "$daemon_pid" ]]; then
      narrate "run-index-daemon: the daemon is listening but wrote no pid to ${PID_FILE}, so --stop"
      narrate "would have nothing to stop. Kill it by hand: pkill -f 'tddy-index-daemon .*${SOCKET}'"
      exit 1
    fi
    announce "$daemon_pid"
    exit 0
  fi

  # Checked every tick, not only at the end: a daemon that refused its socket or failed to start has
  # already said why, and waiting thirty seconds to read it is thirty seconds of nothing.
  if [[ -n "$daemon_pid" ]] && ! kill -0 "$daemon_pid" 2>/dev/null; then
    narrate "run-index-daemon: the daemon exited before it was listening. Its log said:"
    tail -n 20 "$LOG_FILE" >&2 || true
    rm -f "$PID_FILE"
    exit 1
  fi
  sleep "$READY_TICK_SECONDS"
done

narrate "run-index-daemon: the daemon did not announce a listener on ${SOCKET}. Its log said:"
tail -n 20 "$LOG_FILE" >&2 || true
[[ -n "$daemon_pid" ]] && kill "$daemon_pid" 2>/dev/null || true
rm -f "$PID_FILE"
exit 1

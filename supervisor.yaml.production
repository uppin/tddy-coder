# Production template for tddy-supervisor (installed to $INSTALL_CONFIG_DIR/supervisor.yaml).
#
# This file is the ENTIRE privilege surface of the host. tddy-supervisor is the only root process in
# the stack; tddy-daemon runs as an unprivileged child declared below and asks the supervisor for the
# few operations that need privilege. Nothing the daemon sends can widen what is written here.
#
# Placeholders replaced at install time:
#   __INSTALL_BIN_DIR__          — binary directory (default: /usr/local/bin)
#   __RESOLVED_GIT_PATH__        — the one file git on the install host's PATH resolves to
#   __DAEMON_CONFIG_PATH__       — installed daemon.yaml (default: /etc/tddy/daemon.yaml)
#   __SUPERVISOR_SOCKET_PATH__   — privileged RPC socket (INSTALL_SUPERVISOR_SOCKET_PATH)
#   __DAEMON_SOCKET_PATH__       — the daemon's client-facing socket, bound here and handed to it
#                                  (INSTALL_DAEMON_SOCKET_PATH); the same value goes into daemon.yaml
#   __SOCKET_GROUP__             — group granted access to that socket (INSTALL_SOCKET_GROUP)
#   __DAEMON_USER__              — unprivileged service user (INSTALL_DAEMON_USER)
#   __USERS_FILE_PATH__          — users.yaml beside the configs (CONFIG_DIR/users.yaml)
#   __DAEMON_GROUP__             — service group (INSTALL_DAEMON_GROUP)
#
# THIS FILE OWNS THE DAEMON'S OS IDENTITY. The `user:`/`group:` of the tddy-daemon service below are
# not hints: on every install after the first, ./install reads them back and creates the account,
# adds it to the socket-access group and chowns the daemon's log and auth directories to THEM — the
# env vars only seed a freshly rendered copy of this file, and one that disagrees with an existing
# file is an error, never a silent winner. Editing `user:` here and re-running install moves the
# daemon's directories to the new account.
#
# Unknown keys are a startup failure, not a silently ignored setting: a typo'd security setting must
# fail loudly. Every path here must be absolute.

# The privileged RPC socket. Always owned by root; `group` + `mode` are the whole access grant.
# tddy-supervisor.socket (written by ./install) creates it with the same path/group/mode and passes
# the listening fd, so nothing binds in /run at runtime. Keep the two in sync if you change either.
socket:
  path: __SUPERVISOR_SOCKET_PATH__
  group: __SOCKET_GROUP__
  mode: "0660"

# The GitHub → OS-user mapping: who it is read from, and where each mapped user's daemon socket
# lives (`<sockets_dir>/<user>/daemon.sock`, under /run so every directory above a handed-over
# socket is writable by root alone).
users:
  file: __USERS_FILE_PATH__
  sockets_dir: /run/tddy-users

# Processes the supervisor starts (in this order), reaps, restarts with backoff, and terminates on
# shutdown. `user: root` is rejected at load — a root child would defeat the point of the supervisor.
# Add `working_dir:` / `env:` per service if a service needs more than the supervisor's own cwd and
# environment (the daemon does not: daemon.yaml uses absolute paths).
services:
  - name: tddy-daemon
    exec_start: __INSTALL_BIN_DIR__/tddy-daemon
    args: ["-c", "__DAEMON_CONFIG_PATH__"]
    user: __DAEMON_USER__
    group: __DAEMON_GROUP__
    # The daemon's local ConnectionService listener. The supervisor binds it as root before the
    # daemon starts and hands it over as fd 3 (LISTEN_FDS/LISTEN_PID), which is the job
    # tddy-daemon.socket used to do — an unprivileged child cannot bind in /run for itself. The
    # path must match `local.socket_path` in daemon.yaml, and the group is what gates client access.
    socket:
      path: __DAEMON_SOCKET_PATH__
      group: __SOCKET_GROUP__
      mode: "0660"
    # One daemon socket per OS user, for that user's tool sessions and agents: the supervisor
    # reads who maps to whom from users.yaml (the top-level `users:` block below), makes each
    # socket as root — directory and socket owned by that user, modes 0700 and 0600 — and hands
    # the listeners to the daemon after its own (fd 3), announced in LISTEN_FDNAMES as
    # `connection:user.<user>:...`. The daemon serves them where they are; it never binds one.
    # A GitHub login users.yaml maps to nobody is refused at the RPC it calls; an OS user with
    # no row gets no socket. Edit users.yaml to change who is mapped: the supervisor picks a
    # valid save up and restarts this service with the new sockets.
    serves_users: true
    restart:
      max_retries: 5
      initial_backoff_ms: 500
      max_backoff_ms: 30000
      stability_threshold_ms: 10000

# Seconds managed services get after SIGTERM before they are SIGKILLed. Keep tddy-supervisor.service's
# TimeoutStopSec above this value so systemd lets the supervisor finish its own shutdown first.
shutdown_grace_secs: 20

# What the daemon may ask the supervisor to spawn, and on whose behalf. ./install renders this
# policy live — session users come from users.yaml (above), so nothing here needs an operator
# before it can be live. With no spawn_policy the supervisor would grant no privilege at all:
# every session, sandbox, streamed and relayed spawn denied. `root` is rejected as a session
# user.
spawn_policy:
  # Where a binary the daemon asks to run may live, for every spawn kind. Each entry is an
  # absolute path naming a directory (any file beneath it) or one trusted file (exactly that
  # file). A requested path is judged by the file it resolves to: that file, every directory
  # above it and the entry itself must be owned by root (or the supervisor's euid) and writable
  # by nobody else — a sticky world-writable directory included. An entry may instead be
  # written as a map, { path: /some/dir, trusted_prefix: true }, to vouch for that directory's
  # own owner and mode while everything below it is still checked; ./install renders /nix/store
  # that way when git resolves into it, and only then.
  #
  # ./install renders the bin dir (everything it installed) plus the one file git resolves to
  # on the install host — never the whole directory git lives in. A binary outside the bin dir
  # that the daemon must run is an operator entry: add its resolved absolute path here as its
  # own file entry.
  exec_roots:
    - __INSTALL_BIN_DIR__
    - __RESOLVED_GIT_PATH__
__NIX_STORE_EXEC_ROOT__
  # Roots a sandbox bind-mount source must fall under. Absent grants no mount; name the roots
  # this host keeps work under, for example:
  # allowed_mount_roots: [/home, /srv/repos]
  #
  # There is no env key list. The daemon's env passes whole to every spawn kind, except:
  # loader variables (LD_*, MALLOC_*, GCONV_PATH, NLSPATH, LOCPATH, HOSTALIASES,
  # RESOLV_HOST_CONF) are refused — LD_PRELOAD on a listed binary is arbitrary code execution
  # as the session user and would make exec_roots meaningless; HOME/USER/LOGNAME are forced
  # from the resolved account; LISTEN_* and TDDY_SUPERVISOR_SOCKET are stripped. A relayed
  # spawn starts from exactly the env the daemon computed; the other kinds start from a
  # minimal base (fixed PATH, plus LANG/TZ forwarded from the supervisor).

# Delegated cgroup v2 subtree and the ceilings every requested limit is CLAMPED to (a session asking
# for more gets less; it is not rejected). DELIBERATELY ABSENT: with no ceilings nothing is clamped.
# The base is derived from /proc/self/cgroup at runtime (the unit's Delegate=yes subtree), so
# base_override is only for pinning it explicitly.
# cgroup:
#   base_override: /sys/fs/cgroup/system.slice/tddy-supervisor.service
#   mount_root: /sys/fs/cgroup
#   controllers: [memory, cpu, pids]
#   supervisor_leaf: supervisor          # leaf the supervisor moves its own process into
#   memory_max_ceiling: 2147483648       # 2 GiB
#   cpu_max_ceiling: "100000 100000"     # 1 CPU, kernel cpu.max format: "<quota_us> <period_us>"
#   pids_max_ceiling: 512

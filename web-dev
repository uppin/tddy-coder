#!/usr/bin/env bash
# Start tddy-daemon (RPC backend) + Vite dev server (HMR frontend).
#
# Vite proxies /rpc → daemon. Edit React code and see changes instantly.
#
# Usage: ./web-dev                        # tddy-daemon with dev.daemon.yaml (see DAEMON_CONFIG)
#        ./web-dev -c my-config.yaml     # extra CLI for tddy-daemon (pass-through)
#        ./web-dev --github-stub         # e.g. extra CLI overrides
#        ./web-dev --headless            # daemon/worker only; no Vite dev server, no web bundle needed
#        ./web-dev --build               # also build every binary the daemon can INVOKE, not just
#                                          tddy-daemon itself: the session worker, the tool binary,
#                                          the sandbox runner, the index daemon, the git shim and the
#                                          worktree mirror (scripts/dev-runtime-binaries.sh). Each is
#                                          resolved at runtime as a sibling of the daemon binary and
#                                          then as a bare name on PATH with no existence check, so a
#                                          stale or missing one fails later, as a session that will
#                                          not start — never as a build error.
#        ./web-dev --resolve-private-repo  # install the JS dependencies through the local private
#                                          npm registry (LOCAL_REGISTRY_URL) instead of the public
#                                          one, via `bun run local-registry-install`. Needed on a
#                                          machine with no public registry access; it rewrites
#                                          node_modules, so it is opt-in rather than automatic.
#
# Both flags are consumed here: everything else on the command line is passed through to
# tddy-daemon, which would reject or misread them.
#
# Environment variables:
#   WEB_HOST        — Address Vite listens on (default: 127.0.0.1). Use 0.0.0.0 for LAN. Separate from
#                     the URL you open in the browser — set VITE_URL for that.
#   VITE_PORT       — Port for Vite dev server. Default: this checkout's own port in 49152-65535,
#                     derived from its path so the browser origin (and the session it keeps) survives
#                     a restart; a random free one, with a notice, while that is held. Printed at
#                     startup. VITE_URL naming a port pins it. A pinned port already in use is an
#                     error — ./web-dev never kills what it did not start.
#   DAEMON_PORT     — Port tddy-daemon listens on (written into its temp config). Default: this
#                     checkout's own port, chosen the same way.
#   VITE_URL        — **Only env you need for “where is the app?”** Browser-facing origin (OAuth,
#                     import.meta.env.VITE_URL). Default: http://127.0.0.1:<VITE_PORT>. A port in it
#                     pins VITE_PORT — set one when a real GitHub OAuth app needs a fixed redirect. LAN example:
#                     VITE_URL=http://192.168.1.10:5173 (host must match how you open the page).
#                     web-dev exports WEB_PUBLIC_URL=$VITE_URL for tddy-daemon (do not set WEB_PUBLIC_URL
#                     for web-dev; a stale value in .env is overridden).
#   BUILD_TARGETS   — Space-separated cargo packages built (debug) before anything starts, so the
#                     compile is not charged against the daemon readiness timeout.
#                     Default: tddy-daemon. E.g. BUILD_TARGETS="tddy-daemon tddy-coder" ./web-dev
#   LOCAL_REGISTRY_URL — Private npm registry used by --resolve-private-repo
#                     (default: the one scripts/local-bun-install.sh declares).
#   DAEMON_CONFIG   — YAML for tddy-daemon (default: dev.daemon.yaml at repo root).
#                     CONFIG from .env is not used for the daemon backend; use DAEMON_CONFIG.
#   TDDY_DAEMON_INSTANCE_ID — Override the daemon's LiveKit instance id (its participant identity in
#                     the shared room). Overrides daemon_instance_id in the YAML; default is the
#                     YAML value (dev) or the machine hostname. Inherited by tddy-daemon via env.
#   LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET — an existing LiveKit server to reuse. Unset
#                     (the default), web-dev starts its own LiveKit container in Docker and removes it
#                     on exit, including an error exit; set all three (in .env or the environment)
#                     and that server is reused instead, after a reachability check. A partial set is
#                     an error. LIVEKIT_PUBLIC_URL may stand in for LIVEKIT_URL. A LiveKit web-dev did
#                     not start is never stopped. See scripts/dev-livekit.sh.
#   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GITHUB_REDIRECT_URI — GitHub OAuth (tddy-daemon)
#   TDDY_TELEGRAM_BOT_TOKEN, TDDY_TELEGRAM_CHAT_IDS, TDDY_TELEGRAM_ENABLED — Telegram (tddy-daemon);
#                     see docs/ft/daemon/telegram-notifications.md
#
# Press Ctrl+C to stop both servers. A daemon or Vite port already in use is an error naming its
# holder: ./web-dev never kills a process it did not start.
set -euo pipefail
cd "$(dirname "$0")"

# DEV_RUNTIME_PACKAGES + dev_runtime_cargo_args() — the one list of runtime-invocable packages,
# shared with ./desktop-dev so the two launchers cannot drift apart.
# shellcheck source=scripts/dev-runtime-binaries.sh
source scripts/dev-runtime-binaries.sh
# dev_livekit_up / dev_livekit_down — this run's LiveKit: its own container, or a reused server.
# shellcheck source=scripts/dev-livekit.sh
source scripts/dev-livekit.sh
# dev_require_free_port / dev_wait_any — what `fuser -k` and `wait -n` were meant to do, on the
# macOS /bin/bash 3.2 too, where neither works.
# shellcheck source=scripts/dev-process.sh
source scripts/dev-process.sh

daemon_pid=""
vite_pid=""
# What this run starts, for the next run to stop should this one die without cleaning up (kill -9,
# a crashed terminal). Per checkout; removed by on_exit once this run owns it.
RUN_RECORD="tmp/web-dev.run"
RUN_RECORD_OWNED=false

# Stop the daemon and Vite this run started. Job control (`set -m`, below) makes each one lead its
# own process group, so `kill -- -<pid>` reaches the nix shell and everything under it.
stop_children() {
  local pids=() pid
  # By group, not by leader: the nix shell leading a group can exit while the daemon under it lives.
  # These groups are this run's own, and a group id cannot be reused while any member is alive.
  for pid in $daemon_pid $vite_pid; do
    kill -0 -- "-$pid" 2>/dev/null && pids+=("$pid")
  done
  [ "${#pids[@]}" -gt 0 ] || return 0
  for pid in "${pids[@]}"; do kill -TERM -- "-$pid" 2>/dev/null || true; done
  for _ in 1 2 3 4 5; do
    local alive=false
    for pid in "${pids[@]}"; do kill -0 -- "-$pid" 2>/dev/null && alive=true; done
    [ "$alive" = "true" ] || return 0
    sleep 1
  done
  for pid in "${pids[@]}"; do kill -0 -- "-$pid" 2>/dev/null && kill -KILL -- "-$pid" 2>/dev/null || true; done
}


# Runs on every exit — normal, Ctrl+C and error alike — so neither the processes nor the LiveKit
# container this run started outlive it.
on_exit() {
  stop_children
  rm -f "${TMP_CONFIG:-}"
  dev_livekit_down
  [ "$RUN_RECORD_OWNED" = "true" ] && rm -f "$RUN_RECORD"
  return 0
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# The terminal closing ends the run as well: its children are in their own process groups (set -m)
# and would not receive the hang-up themselves.
trap 'exit 129' HUP

# Load .env if present (does not override already-set env vars)
if [ -f .env ]; then
  while IFS='=' read -r key value; do
    # Skip comments and blank lines
    [[ -z "$key" || "$key" == \#* ]] && continue
    # Strip surrounding quotes from value
    value="${value%\"}" ; value="${value#\"}"
    value="${value%\'}" ; value="${value#\'}"
    # Only set if not already in environment
    if [ -z "${!key+x}" ]; then
      export "$key=$value"
    fi
  done < .env
fi

# Flags this script owns. Each is consumed here and NOT passed to the daemon; everything else is
# forwarded untouched (-c, --github-stub, ...).
#   --headless              launch only tddy-daemon (RPC/worker backend); skip the Vite dev server.
#                           In this mode no web bundle is needed.
#   --build                 build the whole runtime-invocable set, not just BUILD_TARGETS.
#   --resolve-private-repo  install JS deps through the local private npm registry first.
HEADLESS=false
WANT_BUILD=false
RESOLVE_PRIVATE_REPO=false
filtered_args=()
for arg in "$@"; do
  case "$arg" in
    --headless) HEADLESS=true ;;
    --build) WANT_BUILD=true ;;
    --resolve-private-repo) RESOLVE_PRIVATE_REPO=true ;;
    *) filtered_args+=("$arg") ;;
  esac
done
set -- "${filtered_args[@]+"${filtered_args[@]}"}"

WEB_HOST="${WEB_HOST:-127.0.0.1}"
# Daemon YAML path for this script (not the generic CONFIG env var from .env).
# DAEMON_CONFIG overrides; default is dev.daemon.yaml at repo root.
CONFIG="${DAEMON_CONFIG:-dev.daemon.yaml}"

# DAEMON_PORT, VITE_PORT, VITE_URL: ephemeral unless pinned, pinned ones checked free — before
# anything is built or started, so a run never collides with another worktree's or an earlier one's
# (which would otherwise answer the readiness check below in the new daemon's place). A held port is
# reported, never killed — see scripts/dev-process.sh.
mkdir -p tmp
dev_reap_previous_run "$RUN_RECORD"
dev_run_record_init "$RUN_RECORD"
RUN_RECORD_OWNED=true
dev_resolve_ports

daemon_args=()
if [ -f "$CONFIG" ]; then
  # Replace CURRENT_USER with $USER in a temp copy (daemon config uses os_user), and listen on this
  # run's DAEMON_PORT rather than the YAML's fixed one.
  # Use | as delimiter so slashes in paths inside YAML are not conflated with sed's replacement.
  TMP_CONFIG=$(mktemp)
  sed -e "s|CURRENT_USER|${USER}|g" \
    -e "s|^\([[:space:]]*web_port:\).*|\1 ${DAEMON_PORT}|" \
    "$CONFIG" > "$TMP_CONFIG"
  daemon_args+=("-c" "$TMP_CONFIG")
else
  echo "tddy-daemon requires -c CONFIG. ${CONFIG} not found." >&2
  exit 1
fi

# Pass through all user args (may include -c, --github-stub, etc.). If the user also passes -c,
# the daemon may receive two -c flags; effective config is daemon-defined, and the Vite proxy still
# targets this run's DAEMON_PORT.
daemon_args+=("$@")

# Public origin for OAuth / SPA: VITE_URL only (not WEB_HOST — that is bind-only). Do not read
# WEB_PUBLIC_URL here — .env often points it at the daemon port by mistake; we always set
# WEB_PUBLIC_URL from VITE_URL for the daemon.
export WEB_PUBLIC_URL="${VITE_URL}"

echo "=== Starting tddy-daemon on :${DAEMON_PORT} (config: ${CONFIG}) ==="
echo "=== VITE_URL=${VITE_URL} (open this in the browser; OAuth redirect base for daemon) ==="

# Readiness uses GET /api/config (always 200 when the daemon is up). Do not use GET / alone:
# without packages/tddy-web/dist (run: ./dev bun run build), static / may 404 while RPC is fine.
if [ "$HEADLESS" != "true" ] && [ ! -f packages/tddy-web/dist/index.html ]; then
  echo "=== Note: packages/tddy-web/dist/index.html missing — open the Vite URL above for HMR; optional: ./dev bun run build for daemon static bundle ===" >&2
fi

# --resolve-private-repo: resolve and install the JS dependencies against the private registry
# before anything else, so Vite starts from a node_modules that exists. Delegates to the repo's
# own two-step script (lock resolution, then a registry-pinned install) rather than reimplementing
# it — see package.json's local-registry-install and scripts/local-bun-install.sh.
if [ "$RESOLVE_PRIVATE_REPO" = "true" ]; then
  echo "=== Installing JS dependencies from the private registry (${LOCAL_REGISTRY_URL:-default}) ==="
  if ! ./dev bun run local-registry-install; then
    echo "Error: private-registry install failed — not starting the daemon." >&2
    exit 1
  fi
fi

# Build first, while nothing is running yet: source changes are still picked up automatically,
# but the compile time is not charged against the daemon readiness timeout further below.
# BUILD_TARGETS (space-separated cargo package names) can extend what is built, e.g.
#   BUILD_TARGETS="tddy-daemon tddy-coder" ./web-dev
# --build adds every package whose binary the running daemon can invoke — see
# scripts/dev-runtime-binaries.sh for why a missing one is not a build error.
BUILD_TARGETS="${BUILD_TARGETS:-tddy-daemon}"
if [ "$WANT_BUILD" = "true" ]; then
  # shellcheck disable=SC2086 # BUILD_TARGETS is a space-separated list of package names by design
  dev_runtime_cargo_args $BUILD_TARGETS
  build_pkg_args=("${DEV_RUNTIME_CARGO_ARGS[@]}")
  build_display="${DEV_RUNTIME_CARGO_PACKAGES[*]}"
else
  build_pkg_args=()
  for pkg in $BUILD_TARGETS; do
    build_pkg_args+=("-p" "$pkg")
  done
  build_display="$BUILD_TARGETS"
fi
echo "=== Building (debug): ${build_display} ==="
if ! ./dev cargo build "${build_pkg_args[@]}"; then
  echo "Error: build failed — not starting the daemon." >&2
  exit 1
fi

DAEMON_BIN="${CARGO_TARGET_DIR:-target}/debug/tddy-daemon"
if [ ! -x "$DAEMON_BIN" ]; then
  echo "Error: ${DAEMON_BIN} not found after build." >&2
  exit 1
fi

# After the build (a failed build starts nothing) and before the daemon, which reads the
# LIVEKIT_* overrides this exports. on_exit removes the container again. The daemon and Vite ports
# are chosen but not yet bound, so the container's port block must be kept off them explicitly.
DEV_LIVEKIT_AVOID_PORTS="${DAEMON_PORT} ${VITE_PORT}"
dev_livekit_up
[ -n "$DEV_LIVEKIT_CONTAINER" ] && dev_run_record_container "$RUN_RECORD" "$DEV_LIVEKIT_CONTAINER"
echo "=== LiveKit: ${LIVEKIT_URL:-${LIVEKIT_PUBLIC_URL:-}} ==="

# Each background launch below leads its own process group, so stop_children can stop it whole.
set -m

# Ensure writable build output dirs exist before the daemon starts.
mkdir -p tmp/buildroot/disks tmp/buildroot/dl

# Start the built binary directly (not `cargo run`) so compilation happens here, before the
# readiness timeout below: a cold/nix build takes far longer than the 90s the wait loop allows.
./dev "$DAEMON_BIN" "${daemon_args[@]}" &
daemon_pid=$!
dev_run_record_group "$RUN_RECORD" "$daemon_pid"

# Wait for the daemon to answer HTTP 200 on /api/config. nix + daemon can take 10–15s on a first
# run, so allow 90s — but stop the moment the daemon exits instead of waiting that out.
if ! dev_wait_http_ready "http://127.0.0.1:${DAEMON_PORT}/api/config" "$daemon_pid" 90 tddy-daemon; then
  echo "Check tmp/logs/daemon for errors." >&2
  exit 1
fi

# Headless: daemon/worker only. No Vite dev server, no web bundle. Wait on the daemon.
if [ "$HEADLESS" = "true" ]; then
  echo ""
  echo "=== Headless mode: tddy-daemon running on :${DAEMON_PORT} (no Vite dev server) ==="
  echo "  Daemon (RPC):  http://127.0.0.1:${DAEMON_PORT}"
  echo ""

  dev_wait_any "$daemon_pid"
  echo "Daemon exited — stopping" >&2
  exit 1
fi

echo ""
echo "=== Starting Vite dev server on ${WEB_HOST}:${VITE_PORT} ==="
echo ""
echo "  --- Hot reload (HMR) ---"
echo "  Use the Vite dev URL below. Edits under packages/tddy-web/ apply live."
echo "  Do NOT use the daemon port for frontend dev: it serves packages/tddy-web/dist"
echo "  (last production build) and has no Vite / HMR."
echo ""
echo "  App (HMR):     ${VITE_URL}"
echo "  Daemon (RPC):  http://127.0.0.1:${DAEMON_PORT}  — static dist; /rpc and /api proxied by Vite"
echo ""

# Start Vite dev server with DAEMON_PORT for proxy config (run via ./dev for nix env)
./dev bash -c "cd packages/tddy-web && DAEMON_PORT='$DAEMON_PORT' WEB_PUBLIC_URL='$WEB_PUBLIC_URL' VITE_URL='$VITE_URL' bunx vite --port '$VITE_PORT' --strictPort --host '$WEB_HOST'" &
vite_pid=$!
dev_run_record_group "$RUN_RECORD" "$vite_pid"

# Run until either exits (or Ctrl+C); on_exit stops the other and removes the LiveKit container.
dev_wait_any "$daemon_pid" "$vite_pid"
if [ "$DEV_EXITED_PID" = "$daemon_pid" ]; then
  echo "Daemon exited unexpectedly — stopping" >&2
else
  echo "Vite exited unexpectedly — stopping" >&2
fi
exit 1

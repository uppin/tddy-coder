# Production template for Tddy Desktop's embedded tddy-daemon.
#
# `./install --desktop` renders this to __TDDY_DATA_DIR__/desktop.yaml, which is the ONLY file a
# release build of the application reads (see packages/tddy-desktop/src-tauri/src/config_source.rs).
# There is no fallback: no TDDY_DAEMON_CONFIG, no repo-root dev.desktop.yaml, no walk up the
# directory tree looking for a checkout — an installed .app launched from the Dock has `/` for a
# working directory, so anything it found that way it would have found by accident.
#
# Unknown keys are a STARTUP FAILURE, not an ignored setting: every key below is one
# `tddy_daemon_kernel::config::DaemonConfig` declares.
#
# Placeholders replaced at install time:
#   __TDDY_DATA_DIR__     — sessions, agent state and this file (default: $HOME/.tddy)
#   __DAEMON_LOG_DIR__    — daemon file-log dir (default: $HOME/.tddy/logs)
#   __AUTH_STORAGE_DIR__  — OAuth/token storage base (default: $HOME/.tddy; `/auth` is appended)
#   __INSTALL_BIN_DIR__   — where ./install --desktop put the CLI binaries (default: $HOME/.local/bin)
#
# An existing __TDDY_DATA_DIR__/desktop.yaml is NEVER overwritten by a reinstall. Delete it to have
# `./install --desktop` render this template again.

# The application has no terminal when it is launched from the Dock, so the log goes to a file.
# `output:` also takes `stderr`, `stdout`, `buffer`, `mute`, or a list — add `stderr` when you run
# the app from a shell and want the lines there too.
log:
  loggers:
    default:
      output: { file: "__DAEMON_LOG_DIR__/daemon" }
      format: "{timestamp} [{level}] [{target}] {message}"
    webrtc:
      output: { file: "__DAEMON_LOG_DIR__/webrtc" }
      format: "{timestamp} [{level}] [{target}] {message}"
  default:
    level: info
    logger: default
  # Verbose WebRTC / LiveKit SDK chatter, kept out of the daemon log.
  policies:
    - selector: { target: libwebrtc* }
      logger: webrtc
    - selector: { target: livekit* }
      logger: webrtc
    - selector: { target: livekit_api* }
      logger: webrtc

# Sessions, agent state and the models database. Named explicitly rather than left to the release
# default ($HOME/.tddy) so that moving the install with INSTALL_TDDY_HOME moves the data with it.
tddy_data_dir: "__TDDY_DATA_DIR__"

# Where this daemon keeps its auth state: the Ed25519 key it signs session tokens with
# (signing_key.pem, mode 0600, generated on first boot and reused on every boot after — deleting it
# ends every signed-in session) and each GitHub login's retained access token (github-tokens.json,
# mode 0600). The daemon REFUSES TO START when this is set and not writable, because a failed token
# write would fail every login — ./install --desktop creates it mode 0700, and the daemon warns at
# startup if it has since been opened wider.
auth_storage: "__AUTH_STORAGE_DIR__/auth"

# NO `web_bundle_path:` ON PURPOSE: the dashboard is embedded in the application at build time, so
# there is no directory to serve it from.

# The daemon binds NOTHING here, and `listen:` is not a contradiction of that. The block is
# REQUIRED — `tddy_daemon::runtime::build` refuses to assemble a daemon without `listen.web_port`,
# whatever the deployment. `web_port` is the loopback port a *redirect-flow* sign-in comes back on
# (a one-path `/auth/callback` listener on 127.0.0.1, packages/tddy-desktop/src-tauri/src/oauth_callback.rs);
# the device-flow sign-in configured below never returns through it.
listen:
  web_port: 8899
  web_host: 127.0.0.1

# WHO MAY SIGN IN: the Tddy Desktop GitHub OAuth App, as a PUBLIC client.
#
# A `client_id` with NO `client_secret` registers the GitHub **device flow**: the dashboard shows a
# short code, the operator approves it on github.com, and the daemon polls GitHub until it does. A
# client id is public by definition, so nothing confidential ships in this file or the application.
# Adding a `client_secret` would make this a confidential client serving the redirect flow instead —
# a served deployment's shape, not a desktop's. It is an OAuth App (not a GitHub App) because its
# user token does not expire, so no refresh exchange ever needs a secret.
github:
  client_id: "Ov23lioH6CfiaZR8ESr5"

# WHICH OS USER A LOGIN RUNS SESSIONS AS: nobody yet, on purpose.
#
# The FIRST GitHub login completed from this application's own window is enrolled here against the
# OS user the application runs as, and persisted to this file (rewriting it drops these comments).
# From then on that row is an ordinary mapping: a different GitHub login is refused
# `permission_denied: user not mapped to OS user` on every session RPC, and there is deliberately no
# fallback to "whoever the daemon runs as". A login arriving over any other transport — a LiveKit
# common room, an agent's tool socket — is never enrolled. Peers in a common room must name the same
# login, so change `github_user` on every side together.
#
# NO `livekit:` BLOCK IS NEEDED TO SIGN IN. The daemon signs session tokens with its own key (see
# `auth_storage` above); `livekit.api_secret` signs LiveKit room JWTs only, and is configured when
# the application should join a common room.
users: []

# Append `-<unix_ms>` to this daemon's LiveKit identity once per process, so the installed
# application and a `./desktop-dev` run on the same machine do not collide with DuplicateIdentity.
daemon_instance_id_append_startup_timestamp: true

# The agent backends the dashboard offers. An id listed here still needs its CLI on PATH — the
# daemon spawns `claude`, `codex`, `cursor-agent` and friends as this OS user. Discovered
# assistants are added to these rows at runtime.
allowed_agents:
  - id: claude
    label: "Claude"
  - id: claude-acp
    label: "Claude (ACP)"
  - id: codex
    label: "Codex"
  - id: codex-acp
    label: "Codex (ACP)"
  - id: cursor
    label: "Cursor"

# The tools the daemon may spawn, at the absolute paths ./install --desktop copied them to. They are
# also inside the .app next to the application binary, which is how tddy-sandbox-runner and
# tddy-index-daemon are resolved (sibling of the running executable) without being listed here.
allowed_tools:
  - path: "__INSTALL_BIN_DIR__/tddy-coder"
    label: "tddy-coder"
  - path: "__INSTALL_BIN_DIR__/tddy-tools"
    label: "tddy-tools"
